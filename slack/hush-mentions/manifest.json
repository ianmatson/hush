{
	"display_information": {
		"name": "Hush Mentions",
		"description": "Shows Slack messages about a PR or issue in Hush."
	},
	"oauth_config": {
		"redirect_urls": ["https://app.hush-gh.com/api/slack/mentions/callback"],
		"scopes": {
			"user": ["search:read.public", "search:read.private", "search:read.im", "search:read.mpim"]
		}
	},
	"settings": {
		"org_deploy_enabled": false,
		"socket_mode_enabled": false,
		"token_rotation_enabled": false
	}
}
