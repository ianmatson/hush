{
	"name": "hush",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "mkdir -p dist/app && pnpm types:api && concurrently -k -n worker,web -c yellow,cyan \"wrangler dev --port 8787\" \"vite dev\"",
		"build": "vite build && node scripts/split-build.mjs",
		"preview": "pnpm build && wrangler dev --port 8787",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "pnpm types:api",
		"types:api": "tsc -p worker/tsconfig.types.json",
		"check": "svelte-kit sync && pnpm types:api && svelte-check --tsconfig ./tsconfig.json && tsc -p worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:migrate:local": "wrangler d1 migrations apply hush --local",
		"db:migrate:remote": "wrangler d1 migrations apply hush --remote",
		"deploy": "pnpm build && wrangler d1 migrations apply hush --remote && wrangler deploy && wrangler deploy -c wrangler.site.jsonc",
		"keys": "node scripts/gen-keys.mjs",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260924.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.48.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "latest",
		"bits-ui": "^2.19.3",
		"cn": "^0.4.0",
		"concurrently": "^10.0.5",
		"http_ece": "^1.2.1",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"wrangler": "^4.138.0"
	},
	"dependencies": {
		"@fontsource-variable/newsreader": "^5.3.0",
		"@tanstack/query-sync-storage-persister": "^5.103.2",
		"@tanstack/svelte-query": "^6.2.4",
		"@tanstack/svelte-query-persist-client": "^6.2.4",
		"dompurify": "^3.4.16",
		"hono": "^4.13.9"
	}
}
